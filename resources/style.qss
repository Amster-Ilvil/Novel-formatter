QMainWindow { background: #F6F7F9; }
QWidget {
  background: #F6F7F9;
  color: #1D1D1F;
  font-family: "SF Pro Text", "PingFang SC", "Segoe UI", "Noto Sans", sans-serif;
  font-size: 13px;
}
QFrame, QGroupBox, QScrollArea, QTreeWidget, QPlainTextEdit, QTextEdit {
  background: #FFFFFF;
  border: 1px solid #E5E5EA;
  border-radius: 12px;
}
QPushButton, QToolButton, QDialogButtonBox QPushButton {
  background: #FFFFFF;
  color: #4F7FFF;
  border: 1px solid #E5E5EA;
  border-radius: 10px;
  padding: 9px 18px;
  min-height: 18px;
  font-weight: 600;
}
QPushButton:hover, QToolButton:hover { background: #F0F5FF; }
QPushButton:pressed { background: #DCE8FF; }
QPushButton[danger="true"] { background: #E85D5D; color: white; border: none; }
QLineEdit, QComboBox {
  background: #FFFFFF;
  border: 1px solid #E5E5EA;
  border-radius: 10px;
  padding: 7px 11px;
}
QProgressBar {
  background: #E5E5EA;
  border: none;
  border-radius: 999px;
  min-height: 8px;
  max-height: 10px;
}
QProgressBar::chunk {
  background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #6EA8FF, stop:1 #4F7FFF);
  border-radius: 999px;
}

QPushButton {
    min-height: 34px;
    padding: 0 14px;
    border-radius: 9px;
    border: 1px solid #DCDDE2;
    background: #FFFFFF;
    color: #303036;
    font-weight: 600;
}
QPushButton:hover { background: #F4F7FF; border-color: #B7CAFF; }
QPushButton:pressed { background: #E8EFFF; }
QPushButton:disabled { background: #F3F3F5; color: #A1A1A6; border-color: #E4E4E7; }
QPushButton[variant="primary"] { background: #4F7FFF; color: #FFFFFF; border: 1px solid #4F7FFF; }
QPushButton[variant="primary"]:hover { background: #416FE5; border-color: #416FE5; }
QPushButton[variant="danger"] { background: #FFFFFF; color: #D92D20; border-color: #F0B7B2; }
QPushButton[variant="warning"] { background: #FFF8EB; color: #B54708; border-color: #F5D39A; }
QPushButton[variant="ghost"] { background: transparent; color: #4F7FFF; border: none; }

QProgressBar {
    min-height: 8px;
    max-height: 8px;
    border: none;
    border-radius: 4px;
    background: #E9EAEF;
    text-align: center;
}
QProgressBar::chunk { border-radius: 4px; background: #4F7FFF; }
QSplitter::handle { background: #E8E8EC; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QSplitter::handle:hover { background: #B8CAFF; }
QFrame[card="true"] { background: #FFFFFF; border: 1px solid #E1E2E6; border-radius: 12px; }
QLabel[status="running"] { color: #3468D4; }
QLabel[status="success"] { color: #067647; }
QLabel[status="warning"] { color: #B54708; }
QLabel[status="error"] { color: #D92D20; }
QWidget#previewWorkspace { background: #F2F3F5; border: 1px solid #E1E2E6; border-radius: 12px; }
